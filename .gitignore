# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# OS / 에디터
.DS_Store
.vscode/
.idea/

# SUMO 생성 파일: train.py / test.py / view_road.py / collect_pomdp_data.py가
# 실행될 때마다 road_builder.build()가 다시 만든다 (net.xml에 생성 시각이 찍혀서 매번 바뀜).
# 도로를 바꾸려면 env/road_config.py, env/road_builder.py를 고친다.
env/sumo/
env/sumo_eval/

# 학습 결과: 각자 로컬에만 둔다. 최종 모델은 Hugging Face에 올린다.
results/

# 수집 데이터: git이 아니라 Hugging Face Dataset에 올린다.
data/*.jsonl.gz
data/*.npz
data/*.parquet
data/shards/
!data/sample/

# 기타
*.bak
*.log

# 영역 지도: 사용자 지도 캡처를 겹친 확인 이미지(지도 저작권)와 로컬 경로가 든 설정은 올리지 않는다
env/maps/*.overlay.png
env/maps/*.netccfg

# 모방학습 도구(tools/rl/expert_collect.py, dagger_collect.py)가 만드는 SUMO 폴더
env/sumo_expert/
env/sumo_expert_*/
