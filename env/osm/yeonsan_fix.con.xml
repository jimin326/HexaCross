<?xml version="1.0" encoding="UTF-8"?>
<!--
    연산교차로 연결 보정 파일 (netconvert connection 파일)

    OSM 원본(yeonsan_cityhall.osm)은 고치지 않고, 실제 도로와 다른 연결만 여기서 바로잡는다.
    osm_builder.build_osm()이 netconvert의 connection-files 옵션으로 넘긴다
    (road_config.ROAD["osm"]["fix_connections"]).

    근거: docs/research/연산교차로_도로조사.md
    edge id는 netconvert가 OSM을 읽을 때 붙이는 이름 (OSM way id, 나뉜 조각은 #번호,
    반대 방향은 앞에 -)이다. OSM 파일을 다시 받으면 id가 바뀔 수 있으니
    docs/research/check_lanes.py로 결과를 꼭 확인할 것.
-->
<connections>
    <!-- ─────────────────────────────────────────────────────────────
         1) 금지 회전 (국가교통정보센터 표준노드링크 TURNINFO + 로드뷰 표지판.
            PR #1 실측 OD에서도 이 방향은 0대)
         ───────────────────────────────────────────────────────────── -->
    <!-- SW 중앙대로(서면) → W 월드컵대로(사직) 좌회전 금지 -->
    <delete from="512187678#16" to="506007334"/>
    <!-- N 중앙대로(동래) → NE 반송로 좌회전 금지 -->
    <delete from="1494563723#1" to="37400617#0"/>
    <!-- N 중앙대로(동래) → E 고분로 좌회전 금지 -->
    <delete from="1494563723#1" to="-794688378"/>
    <!-- N 중앙대로(동래) 유턴 (실제 진입부에 유턴 차로 없음) -->
    <delete from="1494563723#1" to="1381093796"/>
    <!-- NE 반송로 → S 월드컵대로(남) 좌회전 금지 -->
    <delete from="-37400617#0" to="-795083570"/>
    <!-- NE 반송로 → E 고분로 좌회전 금지 -->
    <delete from="-37400617#0" to="-794688378"/>
    <!-- NE 반송로 유턴은 netconvert의 no-turnarounds 옵션으로 이미 안 생김 -->

    <!-- ─────────────────────────────────────────────────────────────
         2) 정지선 앞 차로별 방향 (조사 md 각 진입부 "정지선 앞" 표, 일반 차로만)

         차로 번호: SUMO는 인도 쪽이 0 (조사 md는 중앙 쪽부터 1, 2, ...).
         한 edge의 연결을 여기 적으면 netconvert는 그 edge에 다른 연결을 더 만들지
         않는다 → 적지 않은 방향(금지 회전, 교차로 안 우회전)은 생기지 않는다.
         우회전은 교통섬으로 분리된 우회전 연결로(*_link)로만 간다.

         도착 차로: 여러 차로가 같은 곳으로 가면 순서대로, 한 차로만 가면
         좌회전은 맨 왼쪽(1차로), 우회전은 맨 오른쪽 차로로 들어간다.

         진출 edge: N 동래 1381093796 (2차로) / SW 시청 1381093795#0 (2)
                    W 사직 506007334 (2) / S 광안리 -795083570 (3)
                    E 연산터널 -794688378 (2) / NE 안락 37400617#0 (2)
         ───────────────────────────────────────────────────────────── -->

    <!-- SW 중앙대로 서면 (AV 출발). 조사(중앙→인도): 교대 | 교대 | 안락 | 안락·연산터널 | 연산터널
         우회전 연결로 369240560 → 광안리 -->
    <connection from="512187678#16" to="-794688378"   fromLane="0" toLane="0"/>  <!-- 일반5: 연산터널 -->
    <connection from="512187678#16" to="-794688378"   fromLane="1" toLane="1"/>  <!-- 일반4: 연산터널 -->
    <connection from="512187678#16" to="37400617#0"   fromLane="1" toLane="0"/>  <!-- 일반4: 안락 -->
    <connection from="512187678#16" to="37400617#0"   fromLane="2" toLane="1"/>  <!-- 일반3: 안락 -->
    <connection from="512187678#16" to="1381093796"   fromLane="3" toLane="0"/>  <!-- 일반2: 교대 (AV) -->
    <connection from="512187678#16" to="1381093796"   fromLane="4" toLane="1"/>  <!-- 일반1: 교대 (AV) -->

    <!-- N 중앙대로 동래. 조사(중앙→인도): 수영 | 수영 | 시청 | 시청
         우회전 연결로 165290629 → 거제천(사직) -->
    <connection from="1494563723#1" to="1381093795#0" fromLane="0" toLane="0"/>  <!-- 시청 -->
    <connection from="1494563723#1" to="1381093795#0" fromLane="1" toLane="1"/>  <!-- 시청 -->
    <connection from="1494563723#1" to="-795083570"   fromLane="2" toLane="1"/>  <!-- 수영 -->
    <connection from="1494563723#1" to="-795083570"   fromLane="3" toLane="2"/>  <!-- 수영 -->

    <!-- W 월드컵대로 사직. 조사(중앙→인도): 교대·안락 | 안락·연산터널 | 연산터널·수영 | 수영
         우회전 연결로 369240563 → 시청.
         1381093808은 최종 edge 506009344로 합쳐지는 마지막 조각 -->
    <connection from="1381093808" to="-795083570"   fromLane="0" toLane="0"/>  <!-- 수영 -->
    <connection from="1381093808" to="-795083570"   fromLane="1" toLane="1"/>  <!-- 수영 -->
    <connection from="1381093808" to="-794688378"   fromLane="1" toLane="0"/>  <!-- 연산터널 -->
    <connection from="1381093808" to="-794688378"   fromLane="2" toLane="1"/>  <!-- 연산터널 -->
    <connection from="1381093808" to="37400617#0"   fromLane="2" toLane="0"/>  <!-- 안락 -->
    <connection from="1381093808" to="37400617#0"   fromLane="3" toLane="1"/>  <!-- 안락 -->
    <connection from="1381093808" to="1381093796"   fromLane="3" toLane="1"/>  <!-- 교대 -->

    <!-- S 월드컵대로 남쪽. 조사(중앙→인도): 시청 | 거제·교대 | 교대 | 안락·동래
         우회전 연결로 165290628 → 고분로 (조사: 추정) -->
    <connection from="795083570" to="37400617#0"   fromLane="0" toLane="0"/>  <!-- 안락 -->
    <connection from="795083570" to="1381093796"   fromLane="0" toLane="0"/>  <!-- 동래 -->
    <connection from="795083570" to="1381093796"   fromLane="1" toLane="0"/>  <!-- 교대 -->
    <connection from="795083570" to="1381093796"   fromLane="2" toLane="1"/>  <!-- 교대 -->
    <connection from="795083570" to="506007334"    fromLane="2" toLane="1"/>  <!-- 거제 -->
    <connection from="795083570" to="1381093795#0" fromLane="3" toLane="1"/>  <!-- 시청 -->

    <!-- E 고분로. 조사(중앙→인도): 수영·시청 | 시청·거제 | 거제·교대 | 교대
         우회전 연결로 165290633 → 안락 -->
    <connection from="794688378" to="1381093796"   fromLane="0" toLane="0"/>  <!-- 교대 -->
    <connection from="794688378" to="1381093796"   fromLane="1" toLane="1"/>  <!-- 교대 -->
    <connection from="794688378" to="506007334"    fromLane="1" toLane="0"/>  <!-- 거제 -->
    <connection from="794688378" to="506007334"    fromLane="2" toLane="1"/>  <!-- 거제 -->
    <connection from="794688378" to="1381093795#0" fromLane="2" toLane="0"/>  <!-- 시청 -->
    <connection from="794688378" to="1381093795#0" fromLane="3" toLane="1"/>  <!-- 시청 -->
    <connection from="794688378" to="-795083570"   fromLane="3" toLane="2"/>  <!-- 수영 -->

    <!-- NE 반송로. 조사(중앙→인도): 시청 | 시청 | 거제 | 거제
         우회전 연결로 165290630 → 교대 -->
    <connection from="-37400617#0" to="506007334"    fromLane="0" toLane="0"/>  <!-- 거제 -->
    <connection from="-37400617#0" to="506007334"    fromLane="1" toLane="1"/>  <!-- 거제 -->
    <connection from="-37400617#0" to="1381093795#0" fromLane="2" toLane="0"/>  <!-- 시청 -->
    <connection from="-37400617#0" to="1381093795#0" fromLane="3" toLane="1"/>  <!-- 시청 -->

    <!-- ─────────────────────────────────────────────────────────────
         3) 차로가 늘어나는 지점에서 갈라지는 방법
            (netconvert 기본값은 늘어난 차로를 왼쪽으로 몰아서, 오른쪽 차로로
             가야 하는 차가 짧은 구간에서 차로를 여러 번 바꿔야 함)
         ───────────────────────────────────────────────────────────── -->

    <!-- SW: 2 → 5 (정지선 약 80m 전). 왼쪽 차로는 교대 차로 2개로,
         오른쪽 차로는 안락·연산터널 차로 3개와 광안리 연결로 쪽으로 -->
    <connection from="512187678#13" to="165722345"    fromLane="0" toLane="0"/>  <!-- 이면도로 우회전 (기존) -->
    <connection from="512187678#13" to="512187678#14" fromLane="0" toLane="0"/>
    <connection from="512187678#13" to="512187678#14" fromLane="0" toLane="1"/>
    <connection from="512187678#13" to="512187678#14" fromLane="0" toLane="2"/>
    <connection from="512187678#13" to="512187678#14" fromLane="1" toLane="3"/>
    <connection from="512187678#13" to="512187678#14" fromLane="1" toLane="4"/>

    <!-- N: 2 → 4 (가정: 정지선 약 87m 전). 왼쪽 차로는 수영 2개로,
         오른쪽 차로는 시청 2개와 거제천 연결로 쪽으로 -->
    <connection from="1292830755#2" to="-165725285#1" fromLane="0" toLane="0"/>  <!-- 이면도로 우회전 (기존) -->
    <connection from="1292830755#2" to="1381093802#0" fromLane="0" toLane="0"/>
    <connection from="1292830755#2" to="1381093802#0" fromLane="0" toLane="1"/>
    <connection from="1292830755#2" to="1381093802#0" fromLane="1" toLane="2"/>
    <connection from="1292830755#2" to="1381093802#0" fromLane="1" toLane="3"/>

    <!-- S: 3 → 4. 조사: 맨 오른쪽 차로가 3·4차로로 갈라지고 우회전 연결로가 생김 -->
    <connection from="26005519#10" to="165290628"   fromLane="0" toLane="0"/>  <!-- 연결로 → 고분로 -->
    <connection from="26005519#10" to="795083570"   fromLane="0" toLane="0"/>
    <connection from="26005519#10" to="795083570"   fromLane="0" toLane="1"/>
    <connection from="26005519#10" to="795083570"   fromLane="1" toLane="2"/>
    <connection from="26005519#10" to="795083570"   fromLane="2" toLane="3"/>

    <!-- E: 2 → 4. 조사: 1차로 → 1·2차로, 2차로 → 3·4차로 (+ 우회전 연결로) -->
    <connection from="794688377#1" to="165290633"   fromLane="0" toLane="0"/>  <!-- 연결로 → 안락 -->
    <connection from="794688377#1" to="794688378"   fromLane="0" toLane="0"/>
    <connection from="794688377#1" to="794688378"   fromLane="0" toLane="1"/>
    <connection from="794688377#1" to="794688378"   fromLane="1" toLane="2"/>
    <connection from="794688377#1" to="794688378"   fromLane="1" toLane="3"/>

    <!-- NE: 2 → 4 (가정: 들어오는 구간 2차로). 왼쪽 차로는 시청 2개로,
         오른쪽 차로는 거제 2개와 교대 연결로 쪽으로 -->
    <connection from="-37400617#1" to="165290630"   fromLane="0" toLane="0"/>  <!-- 연결로 → 교대 -->
    <connection from="-37400617#1" to="-37400617#0" fromLane="0" toLane="0"/>
    <connection from="-37400617#1" to="-37400617#0" fromLane="0" toLane="1"/>
    <connection from="-37400617#1" to="-37400617#0" fromLane="1" toLane="2"/>
    <connection from="-37400617#1" to="-37400617#0" fromLane="1" toLane="3"/>
</connections>
